PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=ustabul
DB_PASSWORD=replace-with-local-postgres-password
DB_NAME=ustabul_db
DATABASE_URL=postgresql://ustabul:replace-with-local-postgres-password@localhost:5432/ustabul_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT & Auth: generate separate random values for local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
